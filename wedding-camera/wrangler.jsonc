{
  "name": "paul-60-camera",
  "main": "worker/index.js",
  "compatibility_date": "2026-03-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paul-60-camera-db",
      "database_id": "CREATE_NEW_D1_DATABASE_BEFORE_DEPLOYING"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "paul-60-camera-photos"
    }
  ]
}
